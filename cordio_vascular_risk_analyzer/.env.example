# Hugging Face Access Token (Required for AI Heart-Health Chat Assistant)
# Generate a token with "Inference Providers" permission at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_access_token_here

# Optional: Custom Hugging Face Model for Chat (Default: openai/gpt-oss-120b:fastest)
HF_MODEL=openai/gpt-oss-120b:fastest
